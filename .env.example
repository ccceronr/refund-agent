# Copy to .env (git-ignored) and fill in the empty values. Never commit .env.
# Comments stay on their own lines: not every .env parser handles inline ones.
# Passwords end up inside connection URLs, so use URL-safe values, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# local | production
APP_ENV=local
# Railway injects PORT; always read it
PORT=8000

# --- Database ---------------------------------------------------------------
# docker compose builds the three URLs from these passwords, so locally you
# only set the passwords and leave the URLs empty. Set the URLs yourself only
# outside compose (Railway: design §11; the app service never gets the admin URL
# or POSTGRES_PASSWORD, the roles bootstrap runs once with `railway run`):
#   DATABASE_ADMIN_URL=postgresql://postgres:<POSTGRES_PASSWORD>@<host>:5432/refunds
#   DATABASE_URL_RW=postgresql+asyncpg://app_rw:<APP_RW_PASSWORD>@<host>:5432/refunds
#   DATABASE_URL_RO=postgresql+asyncpg://agent_ro:<AGENT_RO_PASSWORD>@<host>:5432/refunds
# The admin URL is used only by the roles bootstrap (design §3.3).
POSTGRES_PASSWORD=
APP_RW_PASSWORD=
AGENT_RO_PASSWORD=
DATABASE_ADMIN_URL=
DATABASE_URL_RW=
DATABASE_URL_RO=
DB_CONNECT_TIMEOUT_SECONDS=5
# Host port of the compose Postgres (localhost only). Uncommon on purpose, so it
# doesn't clash with a Postgres already installed on the machine.
DB_HOST_PORT=54320

# --- Models -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_WRITER_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT_SECONDS=30
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=10
RUN_TIMEOUT_SECONDS=90

# --- Business rules (specs/business-rules.md) -------------------------------
REFUND_LIMIT_PER_WINDOW=3
REFUND_WINDOW_DAYS=365
CLAIM_WINDOW_DAYS=60
STAFF_APPROVAL_LIMIT=50.00
AUTO_REFUND_ENABLED=true
AUTO_REFUND_MAX_AMOUNT=35.00
AUTO_MIN_CONFIDENCE=0.95
DECISION_MIN_CONFIDENCE=0.85
INJECTION_THRESHOLD=0.5
AUTO_MAX_INJECTION=0.1

# --- Auth -------------------------------------------------------------------
# At least 32 random bytes:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SEED_PASSWORD_LUIS=
SEED_PASSWORD_MARTA=

# --- Limits and HTTP --------------------------------------------------------
MAX_RUNS_PER_CASE_PER_HOUR=5
MAX_MESSAGE_CHARS_FOR_MODELS=2000
# Rate limits apply to /api/* only
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_RUN=10/minute
MAX_REQUEST_BODY_BYTES=65536
# Normally empty: the Vite dev server proxies /api. Ignored in production.
CORS_ORIGINS=

# --- Evals and tests --------------------------------------------------------
EVAL_MIN_PASS_RATE=0.9
# Test/demo only: jev_down | anthropic_down | slow. Ignored in production.
FAULT_INJECTION=
